# Public, non-secret build switch. Keep `original` until processed photos pass review.
PUBLIC_IMAGE_SET=original

# Provider selection is public configuration. Gemini is implemented; openai and custom are reserved.
PHOTO_PROVIDER=gemini

# Optional request concurrency. Defaults to 3 and accepts 1 through 10.
PHOTO_CONCURRENCY=3

# Mandatory, versioned editorial identity and validation thresholds.
PHOTO_STYLE_PROFILE=photo-processing/style/la-arbolada-style.json
PHOTO_STYLE_MIN_NATURALNESS=80
PHOTO_STYLE_MIN_PROFILE_MATCH=75
PHOTO_POST_ANALYSIS=true
PHOTO_POST_VALIDATION_MIN_REJECT_CONFIDENCE=0.85
PHOTO_POST_VALIDATION_REQUIRE_EVIDENCE=true
PHOTO_POST_VALIDATION_CONTRADICTION_POLICY=manual-review

# Required only when an approved pilot/full run is explicitly started.
GEMINI_API_KEY=

# Optional model overrides. The analysis model returns JSON; the image model returns one edited raster.
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_ASPECT_RATIO=4:3
GEMINI_IMAGE_SIZE=4K
