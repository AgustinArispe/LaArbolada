---
import { contact, whatsappUrl } from '@/config/contact';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner site-shell">
    <a href="#inicio" class="site-footer__brand">Casa La Arbolada</a>
    <nav aria-label="Navegación del pie de página">
      <a href="#casa">Casa principal</a>
      <a href="#alojamiento-independiente">Alojamiento independiente</a>
      <a href="#ubicacion">Ubicación</a>
      <a href="#contacto">Contacto</a>
    </nav>
    <div class="site-footer__meta">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <span>{contact.location}</span>
      <span>Alquiler temporal en Tandil</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>
