---
import RoomChapter from '@/components/journey/RoomChapter.astro';
import type { PropertyJourneyData } from '@/data/journeys';

interface Props {
  journey: PropertyJourneyData;
}

const { journey } = Astro.props;
---

<section class="property-journey" aria-labelledby={`${journey.id}-title`}>
  <header
    id={journey.anchorId}
    class:list={['property-journey__header', `property-journey__header--${journey.id}`]}
    data-nav-section={journey.anchorId}
    data-nav-theme={journey.id === 'casa' ? 'light' : 'dark'}
  >
    <div class="property-journey__overview site-shell">
      <div class="property-journey__copy">
        <p>{journey.id === 'casa' ? 'La residencia principal' : 'Otra forma de alojarse'}</p>
        <h2 id={`${journey.id}-title`}>{journey.heading}</h2>
        <span>{journey.introduction}</span>
        <strong>{journey.facts}</strong>
      </div>
      <figure class="property-journey__media">
        <img
          src={journey.overviewImage.sources.desktop}
          srcset={`${journey.overviewImage.sources.mobile} 900w, ${journey.overviewImage.sources.desktop} 1600w${journey.overviewImage.sources.large ? `, ${journey.overviewImage.sources.large} 2400w` : ''}`}
          sizes="(max-width: 767px) calc(100vw - 2.5rem), 58vw"
          alt={journey.overviewImage.alt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </header>

  <div class="property-journey__body">
    <div class="property-journey__chapters">
      {
        journey.rooms.map((room) => {
          return (
            <RoomChapter
              property={room.property}
              room={room.room}
              roomNumber={room.roomNumber}
              title={room.title}
              description={room.description}
              images={room.images}
              theme={room.theme}
              presentation={room.presentation}
            />
          );
        })
      }
    </div>
  </div>
</section>
