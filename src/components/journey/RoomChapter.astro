---
import { HorizontalFlipGallery } from '@/components/gallery/HorizontalFlipGallery';
import type { CuratedImage, PropertyKey } from '@/data/journeys';
import type { Presentation } from '@/data/roomOrder';

interface Props {
  property: PropertyKey;
  room: string;
  roomNumber: number;
  title: string;
  description?: string;
  images: CuratedImage[];
  theme: 'warm' | 'forest';
  presentation: Presentation;
  navSection?: string;
  showHeading?: boolean;
}

const {
  property,
  room,
  roomNumber,
  title,
  description,
  images,
  theme,
  presentation,
  navSection,
  showHeading = true,
} = Astro.props;

const chapterId = `${property}-ambiente-${roomNumber}`;
const accessibleTitle = title.replace(/\s+\d+$/, '');
---

<section
  id={chapterId}
  class:list={[
    'room-chapter',
    `room-chapter--${theme}`,
    `room-chapter--${presentation}`,
    { 'room-chapter--photo-only': !showHeading },
  ]}
  aria-label={!showHeading ? `Fotografías de ${accessibleTitle}` : undefined}
  aria-labelledby={showHeading ? `${chapterId}-title` : undefined}
  data-nav-section={navSection ?? (property === 'casa' ? 'casa' : 'alojamiento-independiente')}
  data-nav-theme={theme === 'forest' ? 'dark' : 'light'}
  data-property={property}
  data-room={room}
  data-room-number={roomNumber}
  data-image-ids={JSON.stringify(images.map((image) => image.id))}
  data-image-rooms={JSON.stringify(images.map((image) => image.room))}
>
  <div class="room-chapter__inner">
    {
      showHeading && (
        <header class="room-chapter__header">
          <h3 id={`${chapterId}-title`}>{title}</h3>
          {description && <p class="room-chapter__description">{description}</p>}
        </header>
      )
    }

    <div class="room-chapter__gallery">
      <HorizontalFlipGallery
        client:visible={{ rootMargin: '480px' }}
        id={`${chapterId}-galeria`}
        property={property}
        room={room}
        images={images}
      />
    </div>
  </div>
</section>
