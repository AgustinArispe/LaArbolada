---
import { ArrowUpRight } from 'lucide-react';
import ResponsivePropertyImage from '@/components/media/ResponsivePropertyImage.astro';
import { whatsappUrl } from '@/config/contact';
import { journeys } from '@/data/journeys';

const choices = [
  {
    href: '/casa-principal',
    title: 'Residencia principal',
    action: 'Ver Residencia principal',
    image: journeys.casa.overviewImage,
    transitionName: 'casa-principal-image',
    imageClass: 'accommodation-choice--residence',
  },
  {
    href: '/alojamiento-independiente',
    title: 'Departamento independiente',
    action: 'Ver el departamento',
    image: journeys.departamento.overviewImage,
    transitionName: 'alojamiento-independiente-image',
    imageClass: 'accommodation-choice--department',
  },
];
---

<section
  id="alojamientos"
  class="accommodation-selector"
  aria-labelledby="accommodation-selector-title"
  data-nav-section="inicio"
  data-nav-theme="dark"
>
  <header class="accommodation-selector__header site-shell">
    <p class="eyebrow">Elegí tu espacio</p>
    <h2 id="accommodation-selector-title">Dos escalas de estadía.<br />Un mismo paisaje.</h2>
  </header>

  <div class="accommodation-selector__grid site-shell">
    {
      choices.map((choice) => (
        <a
          class:list={['accommodation-choice', choice.imageClass]}
          href={choice.href}
          aria-label={choice.action}
        >
          <figure
            style={`--choice-transition-name: ${choice.transitionName}; --choice-focal-desktop: ${choice.image.focalPoint?.desktop.x ?? 50}% ${choice.image.focalPoint?.desktop.y ?? 50}%; --choice-focal-mobile: ${choice.image.focalPoint?.mobile.x ?? 50}% ${choice.image.focalPoint?.mobile.y ?? 50}%`}
          >
            <ResponsivePropertyImage
              image={choice.image}
              sizes="(max-width: 767px) calc(100vw - 2.5rem), 48vw"
              alt={choice.image.alt}
            />
            <span class="accommodation-choice__shade" aria-hidden="true" />
            <figcaption>
              <h3>{choice.title}</h3>
              <strong>
                {choice.action}
                <ArrowUpRight size={21} strokeWidth={1.7} aria-hidden="true" />
              </strong>
            </figcaption>
          </figure>
        </a>
      ))
    }
  </div>

  <div class="selector-booking site-shell">
    <p>¿Ya sabés qué fechas necesitás?</p>
    <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      Consultar disponibilidad
      <ArrowUpRight size={20} strokeWidth={1.7} aria-hidden="true" />
    </a>
  </div>
</section>
