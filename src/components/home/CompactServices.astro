---
import { Bath, Bed, Car, Flame, Tv, Utensils, Wifi, Heater } from 'lucide-react';

const services = [
  { label: 'Wi-Fi', Icon: Wifi },
  { label: 'Calefacción por radiadores', Icon: Heater },
  { label: 'Smart TV', Icon: Tv },
  { label: 'Ropa de cama', Icon: Bed },
  { label: 'Estacionamiento', Icon: Car },
  { label: 'Parrilla', Icon: Utensils },
  { label: 'Horno de barro', Icon: Flame },
];
---

<section
  id="comodidades"
  class="compact-services"
  aria-labelledby="compact-services-title"
  data-nav-section="comodidades"
  data-nav-theme="light"
>
  <div class="compact-services__layout site-shell">
    <header>
      <p class="eyebrow">Servicios incluidos</p>
      <h2 id="compact-services-title">Lo esencial, listo para llegar.</h2>
    </header>
    <ul>
      {
        services.map(({ label, Icon }, index) => (
          <li style={`--service-index: ${index}`}>
            <span><Icon size={24} strokeWidth={1.55} aria-hidden="true" /></span>
            <strong>{label}</strong>
          </li>
        ))
      }
    </ul>
  </div>
</section>
