---
import { ArrowUpRight, MessageCircle } from 'lucide-react';
import { contact, whatsappUrl } from '@/config/contact';
import { journeys } from '@/data/journeys';

const background = journeys.casa.rooms[11].images[2];
---

<section
  id="ubicacion"
  class="location-story"
  aria-labelledby="location-title"
  data-nav-section="ubicacion"
  data-nav-theme="dark"
>
  <div class="location-story__media">
    <img
      src={background.sources.large ?? background.sources.desktop}
      srcset={`${background.sources.mobile} 900w, ${background.sources.desktop} 1600w${background.sources.large ? `, ${background.sources.large} 2400w` : ''}`}
      sizes="100vw"
      alt="Parque y arroyo en el entorno de Casa La Arbolada."
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="location-story__shade" aria-hidden="true"></div>
  <div class="location-story__content site-shell">
    <h2 id="location-title">Ubicación y cómo llegar</h2>
    <p>
      La Arbolada se encuentra en {contact.location}. Escribinos para recibir la ubicación exacta y
      las indicaciones de llegada.
    </p>
  </div>
</section>

<section
  id="contacto"
  class="contact-panel"
  aria-labelledby="contact-title"
  data-nav-section="contacto"
  data-nav-theme="dark"
>
  <div class="contact-panel__inner site-shell">
    <div class="contact-panel__copy">
      <h2 id="contact-title">Consultá disponibilidad</h2>
      <p>Escribinos para conocer fechas disponibles y opciones de alojamiento.</p>
    </div>
    <a class="contact-panel__action" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
      <MessageCircle size={22} strokeWidth={1.6} aria-hidden="true" />
      <span>Consultar por WhatsApp</span>
      <ArrowUpRight size={20} strokeWidth={1.6} aria-hidden="true" />
    </a>
  </div>
</section>
