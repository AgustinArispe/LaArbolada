---
import ResponsivePropertyImage from '@/components/media/ResponsivePropertyImage.astro';
import type { CuratedImage } from '@/data/journeys';

interface Props {
  title: string;
  eyebrow?: string;
  subtitle?: string;
  facts?: string;
  image: CuratedImage;
  transitionName: string;
}

const { title, eyebrow, subtitle, facts, image, transitionName } = Astro.props;
const focalPoint = image.focalPoint;
---

<section
  id="inicio"
  class="property-hero"
  aria-labelledby="property-hero-title"
  data-nav-section="espacios"
  data-nav-theme="photo"
  style={`--property-transition-name: ${transitionName}; --property-focal-desktop: ${focalPoint?.desktop.x ?? 50}% ${focalPoint?.desktop.y ?? 50}%; --property-focal-mobile: ${focalPoint?.mobile.x ?? 50}% ${focalPoint?.mobile.y ?? 50}%`}
>
  <figure>
    <ResponsivePropertyImage
      image={image}
      sizes="100vw"
      alt={image.alt}
      loading="eager"
      fetchpriority="high"
    />
    <span aria-hidden="true"></span>
  </figure>
  <div class="property-hero__copy site-shell">
    {eyebrow && <p>{eyebrow}</p>}
    <h1 id="property-hero-title"><span>{title}</span></h1>
    {subtitle && <p>{subtitle}</p>}
    {facts && <strong>{facts}</strong>}
    <a href="#espacios">Ver los espacios</a>
  </div>
</section>
