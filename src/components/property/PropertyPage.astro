---
import { ArrowUpRight, Wifi } from 'lucide-react';
import BookingCTA from '@/components/contact/BookingCTA.astro';
import PropertyHero from '@/components/property/PropertyHero.astro';
import RoomChapter from '@/components/journey/RoomChapter.astro';
import ResponsivePropertyImage from '@/components/media/ResponsivePropertyImage.astro';
import type { PropertyJourneyData } from '@/data/journeys';

type Fact = { value: string; label: string };
type AmenityItem = { label: string; Icon: typeof Wifi };

interface Props {
  journey: PropertyJourneyData;
  eyebrow?: string;
  subtitle?: string;
  heroFacts?: string;
  overview: string;
  quickFacts: Fact[];
  amenities: AmenityItem[];
  transitionName: string;
  otherHref: string;
  otherLabel: string;
}

const {
  journey,
  eyebrow,
  subtitle,
  heroFacts,
  overview,
  quickFacts,
  amenities,
  transitionName,
  otherHref,
  otherLabel,
} = Astro.props;

const roomPreview =
  journey.rooms.find((room) => room.title.includes('Sala'))?.images[0] ?? journey.overviewImage;
---

<PropertyHero
  title={journey.heading}
  {eyebrow}
  {subtitle}
  facts={heroFacts}
  image={journey.overviewImage}
  {transitionName}
/>

<section
  id="espacios"
  class="property-overview"
  aria-labelledby="property-overview-title"
  data-nav-section="espacios"
  data-nav-theme="light"
>
  <div class="property-overview__layout site-shell">
    <div class="property-overview__copy">
      <p class="eyebrow">El alojamiento</p>
      <h2 id="property-overview-title">Espacios pensados para estar cómodos.</h2>
      <p>{overview}</p>
    </div>
    <figure>
      <ResponsivePropertyImage
        image={roomPreview}
        sizes="(max-width: 767px) calc(100vw - 2.5rem), 48vw"
        alt={roomPreview.alt}
      />
    </figure>
  </div>
  <dl class="property-quick-facts site-shell">
    {
      quickFacts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<section
  id="comodidades"
  class="property-amenities"
  aria-labelledby="property-amenities-title"
  data-nav-section="comodidades"
  data-nav-theme="dark"
>
  <div class="property-amenities__layout site-shell">
    <header>
      <p class="eyebrow">Comodidades</p>
      <h2 id="property-amenities-title">Todo lo necesario, sin exceso.</h2>
    </header>
    <ul>
      {
        amenities.map(({ label, Icon }) => (
          <li>
            <>
              <Icon size={23} strokeWidth={1.55} aria-hidden="true" />
              <span>{label}</span>
            </>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<BookingCTA id="consultar-antes-galeria" compact simple />

<section
  id="galeria"
  class="property-gallery"
  aria-label="Galería de fotos"
  data-nav-section="galeria"
  data-nav-theme="light"
>
  <header class="property-gallery__header site-shell">
    <p class="eyebrow">Galería de fotos</p>
    <p>Usá las flechas, miniaturas o gestos laterales para avanzar.</p>
  </header>
  <div class="property-gallery__rooms">
    {
      journey.rooms.map((room) => (
        <RoomChapter
          property={room.property}
          room={room.room}
          roomNumber={room.roomNumber}
          title={room.title}
          description={room.description}
          images={room.images}
          theme={room.theme}
          presentation={room.presentation}
          navSection="galeria"
          showHeading={false}
        />
      ))
    }
  </div>
</section>

<nav class="property-crosslinks site-shell" aria-label="Explorar La Arbolada">
  <a href="/">
    <span>El conjunto completo</span>
    <strong>Volver a La Arbolada</strong>
    <ArrowUpRight size={21} strokeWidth={1.7} aria-hidden="true" />
  </a>
  <a href={otherHref}>
    <span>Otra opción de estadía</span>
    <strong>{otherLabel}</strong>
    <ArrowUpRight size={21} strokeWidth={1.7} aria-hidden="true" />
  </a>
</nav>

<BookingCTA simple />
