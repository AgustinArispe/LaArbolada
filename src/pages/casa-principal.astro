---
import { Bath, BedDouble, CookingPot, House, Sofa, ThermometerSun, Tv, Wifi } from 'lucide-react';
import Footer from '@/components/Footer.astro';
import { WhatsAppBubble } from '@/components/contact/WhatsAppBubble';
import { ImmersiveNavbar } from '@/components/navigation/ImmersiveNavbar';
import PropertyPage from '@/components/property/PropertyPage.astro';
import { journeys } from '@/data/journeys';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Residencia principal | La Arbolada, Tandil';
const description =
  'Residencia principal de La Arbolada en Tandil: 3 dormitorios, 7 camas, 3 baños, cocina con barra desayunadora, living comedor y terraza con vista al parque.';
const amenities = [
  { label: '3 dormitorios y 7 camas', Icon: BedDouble },
  { label: '3 baños', Icon: Bath },
  { label: 'Cocina equipada', Icon: CookingPot },
  { label: 'Sala de estar y comedor', Icon: Sofa },
  { label: 'Calefacción por radiadores', Icon: ThermometerSun },
  { label: 'Wi-Fi', Icon: Wifi },
  { label: 'Smart TV', Icon: Tv },
  { label: 'Ropa de cama', Icon: House },
];
---

<BaseLayout {title} {description}>
  <ImmersiveNavbar client:load pageKind="property" currentPath="/casa-principal" />
  <main id="contenido">
    <PropertyPage
      journey={journeys.casa}
      overview="La Residencia cuenta con 3 dormitorios equipados con 7 camas, 3 baños, amplia cocina con barra desayunadora, living comedor y una amplia terraza con vista al parque."
      quickFacts={[
        { value: '3', label: 'Dormitorios' },
        { value: '7', label: 'Camas' },
        { value: '3', label: 'Baños' },
        { value: 'Incluido', label: 'Acceso al parque' },
      ]}
      {amenities}
      transitionName="casa-principal-image"
      otherHref="/alojamiento-independiente"
      otherLabel="Ver el departamento independiente"
    />
  </main>
  <Footer />
  <WhatsAppBubble client:load />
</BaseLayout>
