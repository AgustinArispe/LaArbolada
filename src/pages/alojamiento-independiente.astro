---
import { Bath, BedDouble, CookingPot, House, KeyRound, Sofa, Tv, Wifi } from 'lucide-react';
import Footer from '@/components/Footer.astro';
import { WhatsAppBubble } from '@/components/contact/WhatsAppBubble';
import { ImmersiveNavbar } from '@/components/navigation/ImmersiveNavbar';
import PropertyPage from '@/components/property/PropertyPage.astro';
import { journeys } from '@/data/journeys';
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Departamento independiente | La Arbolada, Tandil';
const description =
  'Este departamento cuenta con un dormitorio con 3 camas, baño y cocina comedor amplia.';
const amenities = [
  { label: 'Dormitorio equipado', Icon: BedDouble },
  { label: 'Baño privado', Icon: Bath },
  { label: 'Cocina propia', Icon: CookingPot },
  { label: 'Sala de estar', Icon: Sofa },
  { label: 'Acceso privado', Icon: KeyRound },
  { label: 'Wi-Fi', Icon: Wifi },
  { label: 'Smart TV', Icon: Tv },
  { label: 'Ropa de cama', Icon: House },
];
---

<BaseLayout {title} {description}>
  <ImmersiveNavbar client:load pageKind="property" currentPath="/alojamiento-independiente" />
  <main id="contenido">
    <PropertyPage
      journey={journeys.departamento}
      overview="Este departamento cuenta con un dormitorio con 3 camas, baño y cocina comedor amplia."
      {amenities}
      transitionName="alojamiento-independiente-image"
      otherHref="/casa-principal"
      otherLabel="Ver la Residencia principal"
    />
  </main>
  <Footer />
  <WhatsAppBubble client:load />
</BaseLayout>
