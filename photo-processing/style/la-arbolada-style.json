{
  "profileId": "casa-la-arbolada",
  "version": "1.0.0",
  "name": "Casa La Arbolada Editorial Style",
  "intent": {
    "category": "premium architectural and hospitality photography",
    "mood": "warm, natural, elegant and welcoming",
    "realism": "strict",
    "consistencyPriority": "high"
  },
  "global": {
    "exposure": "balanced and luminous without clipping",
    "whiteBalance": "slightly warm and natural",
    "contrast": "moderate and soft",
    "localContrast": "subtle",
    "dynamicRange": "natural",
    "saturation": "moderate",
    "vibrance": "controlled",
    "shadows": "open but realistic",
    "highlights": "soft and recovered",
    "blackPoint": "gentle",
    "sharpness": "clean and natural",
    "noiseReduction": "moderate and texture-preserving",
    "hdrLook": "forbidden"
  },
  "colors": {
    "greens": {
      "target": "natural, healthy and slightly warm",
      "forbid": [
        "fluorescent green",
        "neon green",
        "uniform artificial green",
        "excessive saturation"
      ]
    },
    "sky": {
      "target": "soft natural blue with preserved highlights",
      "forbid": [
        "deep artificial blue",
        "sky replacement",
        "generated clouds",
        "weather alteration"
      ]
    },
    "wood": {
      "target": "warm, rich and realistic",
      "forbid": ["orange cast", "red cast", "oversaturation"]
    },
    "whites": {
      "target": "clean, neutral to slightly warm",
      "forbid": ["blue cast", "gray dirty whites", "clipped white surfaces"]
    },
    "stoneAndConcrete": {
      "target": "neutral, textured and realistic"
    },
    "water": {
      "target": "natural reflections and restrained color"
    },
    "skinTones": {
      "target": "natural",
      "note": "Do not alter people semantically if people are present."
    }
  },
  "lighting": {
    "sunlight": "preserve the original direction, intensity and time-of-day character",
    "interiors": "warm and luminous without creating artificial light sources",
    "windows": "balanced when recoverable from existing pixels",
    "goldenLight": "preserve and refine",
    "fakeLight": "forbidden",
    "fakeSunRays": "forbidden"
  },
  "aestheticRestrictions": [
    "no cinematic teal and orange",
    "no social-media filter look",
    "no dramatic grading",
    "no excessive clarity",
    "no crunchy sharpening",
    "no artificial HDR",
    "no color replacement",
    "no semantic alteration"
  ],
  "lockedImages": ["casa-livingcasa", "casa-livingcasa3", "casa-mesalivingcasa4"]
}
