{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casa-la-arbolada.local/schemas/style-profile.schema.json",
  "title": "Casa La Arbolada photo style profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "version",
    "name",
    "intent",
    "global",
    "colors",
    "lighting",
    "aestheticRestrictions",
    "lockedImages"
  ],
  "properties": {
    "profileId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "mood", "realism", "consistencyPriority"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "mood": { "type": "string", "minLength": 1 },
        "realism": { "type": "string", "enum": ["strict"] },
        "consistencyPriority": { "type": "string", "enum": ["high"] }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposure",
        "whiteBalance",
        "contrast",
        "localContrast",
        "dynamicRange",
        "saturation",
        "vibrance",
        "shadows",
        "highlights",
        "blackPoint",
        "sharpness",
        "noiseReduction",
        "hdrLook"
      ],
      "properties": {
        "exposure": { "$ref": "#/$defs/rule" },
        "whiteBalance": { "$ref": "#/$defs/rule" },
        "contrast": { "$ref": "#/$defs/rule" },
        "localContrast": { "$ref": "#/$defs/rule" },
        "dynamicRange": { "$ref": "#/$defs/rule" },
        "saturation": { "$ref": "#/$defs/rule" },
        "vibrance": { "$ref": "#/$defs/rule" },
        "shadows": { "$ref": "#/$defs/rule" },
        "highlights": { "$ref": "#/$defs/rule" },
        "blackPoint": { "$ref": "#/$defs/rule" },
        "sharpness": { "$ref": "#/$defs/rule" },
        "noiseReduction": { "$ref": "#/$defs/rule" },
        "hdrLook": { "type": "string", "enum": ["forbidden"] }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["greens", "sky", "wood", "whites", "stoneAndConcrete", "water", "skinTones"],
      "properties": {
        "greens": { "$ref": "#/$defs/colorWithForbid" },
        "sky": { "$ref": "#/$defs/colorWithForbid" },
        "wood": { "$ref": "#/$defs/colorWithForbid" },
        "whites": { "$ref": "#/$defs/colorWithForbid" },
        "stoneAndConcrete": { "$ref": "#/$defs/colorTarget" },
        "water": { "$ref": "#/$defs/colorTarget" },
        "skinTones": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "note"],
          "properties": { "target": { "$ref": "#/$defs/rule" }, "note": { "$ref": "#/$defs/rule" } }
        }
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sunlight", "interiors", "windows", "goldenLight", "fakeLight", "fakeSunRays"],
      "properties": {
        "sunlight": { "$ref": "#/$defs/rule" },
        "interiors": { "$ref": "#/$defs/rule" },
        "windows": { "$ref": "#/$defs/rule" },
        "goldenLight": { "$ref": "#/$defs/rule" },
        "fakeLight": { "type": "string", "enum": ["forbidden"] },
        "fakeSunRays": { "type": "string", "enum": ["forbidden"] }
      }
    },
    "aestheticRestrictions": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rule" }
    },
    "lockedImages": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "rule": { "type": "string", "minLength": 1 },
    "colorTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": { "target": { "$ref": "#/$defs/rule" } }
    },
    "colorWithForbid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "forbid"],
      "properties": {
        "target": { "$ref": "#/$defs/rule" },
        "forbid": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    }
  }
}
