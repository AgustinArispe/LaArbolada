{
  "schemaVersion": 2,
  "style": {
    "profilePath": "photo-processing/style/la-arbolada-style.json",
    "schemaPath": "photo-processing/style/la-arbolada-style.schema.json",
    "minimumNaturalness": 80,
    "minimumProfileMatch": 75,
    "postAnalysis": true
  },
  "postValidationPolicy": {
    "minimumRejectConfidence": 0.85,
    "requireEvidence": true,
    "contradictionPolicy": "manual-review"
  },
  "provider": {
    "default": "gemini",
    "allowed": ["gemini", "openai", "custom"],
    "concurrency": 3,
    "input": {
      "maximumInlineInputBytes": 14000000,
      "inputJpegQualities": [98, 95, 92, 88]
    },
    "gemini": {
      "name": "Gemini Image Editing API",
      "documentation": "https://ai.google.dev/gemini-api/docs/generate-content/image-generation#image_editing",
      "endpoint": "https://generativelanguage.googleapis.com/v1beta/interactions",
      "model": "gemini-3.6-flash",
      "imageEditingEndpoint": "https://generativelanguage.googleapis.com/v1/models/{model}:generateContent",
      "imageEditingModel": "gemini-3-pro-image",
      "imageOutput": {
        "aspectRatio": "4:3",
        "imageSize": "4K",
        "configurationVersion": "gemini-image-output-v2"
      },
      "timeoutMs": 300000,
      "output": {
        "maximumBytes": 40000000,
        "allowedMimeTypes": ["image/png", "image/jpeg", "image/webp"]
      },
      "retry": {
        "maxAttempts": 5,
        "baseDelayMs": 1000,
        "maxDelayMs": 16000,
        "jitterMs": 350,
        "retryStatuses": [429, 500, 503]
      }
    }
  },
  "sourceDiscovery": {
    "canonicalDirectories": {
      "casa": "assets-raw/CASA ARBOLADA",
      "departamento": "assets-raw/DPTO ARBOLADA"
    },
    "recursive": true,
    "supportedExtensions": [".heic", ".heif", ".jpg", ".jpeg", ".png"],
    "filenameNormalization": {
      "caseInsensitive": true,
      "ignoreSpaces": true,
      "ignoreHyphens": true,
      "ignoreUnderscores": true,
      "ignoreExtension": true
    }
  },
  "policy": {
    "preserveMetadata": true,
    "updateThumbnail": true,
    "includeDetectionData": true,
    "resize": false,
    "autocrop": false,
    "upscale": false,
    "removeBackground": false,
    "removeGlares": false,
    "generativeBackground": false,
    "objectRemoval": false,
    "architectureAlteration": false
  },
  "qualityControl": {
    "mandatoryHumanArchitecturalReview": true,
    "thresholds": {
      "minimumSsim": 0.72,
      "minimumEdgeSsim": 0.9,
      "minimumPsnrDb": 18,
      "maximumAverageLuminanceChange": 0.18,
      "maximumColorHistogramDelta": 0.25,
      "maximumAspectRatioDelta": 0
    }
  },
  "derivatives": {
    "variants": {
      "thumbnail": { "width": 480, "webpQuality": 84, "avifQuality": 58 },
      "mobile": { "width": 840, "webpQuality": 88, "avifQuality": 62 },
      "desktop": { "width": 1280, "webpQuality": 90, "avifQuality": 65 },
      "large": { "width": 1920, "webpQuality": 92, "avifQuality": 68 }
    },
    "blur": { "width": 32, "sigma": 1.2, "quality": 35 }
  },
  "reports": {
    "processingReport": "reports/gemini-processing-report.md",
    "metrics": "reports/gemini-metrics.json",
    "comparisons": "reports/gemini-comparisons.html",
    "comparisonsDirectory": "reports/gemini-comparisons"
  },
